{
  "mcpServers": {
    "engram": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/engram",
      "args": [
        "mcp",
        "--tools=agent",
        "--project",
        "personal-configurations"
      ],
      "disabledTools": [
        "mem_delete",
        "mem_doctor",
        "mem_judge",
        "mem_compare",
        "mem_current_project"
      ]
    }
  }
}
