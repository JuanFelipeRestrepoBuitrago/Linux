        "engram": {
            "command": "/home/pipas/.local/bin/engram",
            "args": ["mcp", "--tools=agent"],
            "env": {},
            "disabled": false,
            "disabledTools": ["mem_delete", "mem_doctor", "mem_judge", "mem_compare"]
        },
        "fetch": {
            "command": "uvx",
            "args": ["mcp-server-fetch"],
            "env": {},
            "disabled": false
        },
        "github-personal": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN",
                "ghcr.io/github/github-mcp-server",
                "stdio"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
            },
            "disabled": false,
            "disabledTools": [
                "add_issue_comment",
                "assign_copilot_to_issue",
                "create_branch",
                "create_or_update_file",
                "delete_file",
                "get_file_contents",
                "get_label",
                "get_latest_release",
                "get_release_by_tag",
                "get_team_members",
                "get_teams",
                "get_tag",
                "delete_repository",
                "create_repository",
                "fork_repository",
                "issue_read",
                "issue_write",
                "list_branches",
                "list_issue_fields",
                "list_issues",
                "list_issue_types",
                "list_releases",
                "list_repository_collaborators",
                "list_tags",
                "request_copilot_review",
                "search_issues",
                "sub_issue_write",
                "update_issue_comment",
                "search_commits",
                "search_code"
            ]
        }
